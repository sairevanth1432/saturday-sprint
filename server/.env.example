# Local development: copy to server/.env (optional; everything below has a working default locally).
# Self-hosting with Docker (docker-compose.yml): copy to server/.env and fill in the "self-hosted" block.
# Vercel: set these in Project → Settings → Environment Variables.

# ---- self-hosted (docker compose)
# DOMAIN=sprint.example.com     # DNS A record → this server; Caddy fetches the HTTPS certificate
# POSTGRES_PASSWORD=            # any long random string
# WEB_CONCURRENCY=2             # Node processes = CPU cores of the machine
# TRUST_PROXY=1                 # 1 behind Caddy; 2 if Cloudflare proxy is also in front

# ---- videos on Cloudflare R2 (free storage up to 10 GB, no bandwidth charges) or any S3-compatible store
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=learning-bytes
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://videos.example.com     # bucket's public custom domain (or its r2.dev URL for testing)
# S3_REGION=auto

# ---- Redis: self-hosted uses REDIS_URL (docker compose sets it); Vercel uses Upstash (KV_REST_API_*)
# REDIS_URL=redis://localhost:6379

# ---- required in production
# APP_SECRET=                   # 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=                  # random string; Vercel Cron sends it to /api/cron/finalize
# OTP_PROVIDER=webhook          # webhook | msg91 | twilio   (console = local development only)

# ---- data stores (Vercel Marketplace sets these when you connect the integrations)
# DATABASE_URL=postgres://…-pooler…/neondb?sslmode=require   # Neon: use the POOLED connection string
# DB_POOL_MAX=5                 # connections per function instance
# KV_REST_API_URL=              # Upstash Redis (or UPSTASH_REDIS_REST_URL)
# KV_REST_API_TOKEN=            # (or UPSTASH_REDIS_REST_TOKEN)
# BLOB_READ_WRITE_TOKEN=        # Vercel Blob store (public) for learning-byte videos
# MAX_VIDEO_MB=500              # keep under 512 MB so the CDN caches each video

# ---- OTP delivery
# OTP_WEBHOOK_URL=https://lms.example.com/internal/send-otp   # receives {phone, code, message, ttlSeconds}
# OTP_WEBHOOK_TOKEN=            # sent as "Authorization: Bearer <token>"
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=            # DLT-approved template containing ##OTP##
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# OTP_TTL_SECONDS=300
# OTP_RESEND_SECONDS=30
# OTP_MAX_PER_HOUR=5
# PHONE_COUNTRY_CODE=91

# ---- load testing a STAGING deployment only (refused on Vercel production)
# ALLOW_TEST_OTP=true           # login codes are returned in the API response

# ---- sessions / admin
# STUDENT_SESSION_DAYS=7
# ADMIN_SESSION_HOURS=8
# ADMIN_REQUIRE_TOTP=true

# ---- Sprint defaults (super admins can change these in Admin → Sprint settings)
# SPRINT_ID=sprint-2026-10-03
# SPRINT_OPEN=2026-10-03T11:00:00+05:30
# SPRINT_CLOSE=2026-10-03T11:30:00+05:30
# SPRINT_DURATION_MIN=20

# ---- local only
# PORT=3000
# DATA_DIR=data                 # local database (PGlite) and uploads live here
# STUDENTS_FILE=data/students.csv
